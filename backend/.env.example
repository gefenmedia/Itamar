DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rav_itamar
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/rav_itamar

# LLM — default is Ollama (local, no API key)
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Embeddings — local sentence-transformers (no API key)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage/pdfs

# Optional: switch to OpenAI instead of Ollama
# LLM_BACKEND=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o
